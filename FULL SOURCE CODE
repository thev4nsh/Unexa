            child: Column(
              children: [
                TextField(
                  decoration: const InputDecoration(
                    labelText: 'Search requests',
                    prefixIcon: Icon(Icons.search_rounded),
                  ),
                  onChanged: (value) => ref.read(verificationSearchQueryProvider.notifier).setQuery(value),
                ),
